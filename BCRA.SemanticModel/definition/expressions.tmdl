expression Consulta_BCRA_V2 = ```
		(offset as text, FechaDesde as date, FechaHasta as date) =>
		let
		    FormatNumber = Text.Split( offset, ",") ,
		    Call_API = 
		    List.Generate(
		        ()=>[Offset = FormatNumber, Index= 0],
		        each [Index] < List.Count([Offset]),
		        each [ 
		            Offset = [Offset], 
		            Index = [Index]+1
		        ],
		        each Json.Document(
		       Web.Contents(
		         "https://api.bcra.gob.ar/estadisticas/v4.0/Monetarias/" 
		            & (try Number.ToText( [Offset]{[Index]} ) otherwise [Offset]{[Index]}) & "?Desde="&Date.ToText( FechaDesde, "yyyy-MM-dd")&"&Hasta="&Date.ToText( FechaHasta, "yyyy-MM-dd")
		      ) 
		    )[results]{0}
		    ),
		    #"Convertida en tabla" = Table.FromList(Call_API, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
		    Expander_idVariable = Table.ExpandRecordColumn(#"Convertida en tabla", "Column1", {"idVariable", "detalle"}, {"idVariable", "detalle"}),
		    #"Se expandió filas" = Table.ExpandListColumn(Expander_idVariable, "detalle"),
		    #"Se expandió detalle" = Table.ExpandRecordColumn(#"Se expandió filas", "detalle", {"fecha", "valor"}, {"fecha", "valor"})
		in
		    #"Se expandió detalle"
		```
	lineageTag: fcdd96ba-6441-4ccd-9984-56b65635a868
	queryGroup: Aux

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Function

expression ConsultarDatosBCRA =
		(Nros_idVariable as text, FechaDesde as date, FechaHasta as date) as table =>
		let
		    IDs = List.Distinct(List.Transform(Text.Split(Nros_idVariable, ","), each Number.FromText(Text.Trim(_)))),
		    Validados = if FechaDesde > FechaHasta or List.IsEmpty(IDs) then error "Revisar variables y fechas de consulta." else IDs,
		    Limite = 1000,
		    Pagina = (ID as number, Desplazamiento as number) as list =>
		        let
		            Respuesta = Json.Document(Web.Contents("https://api.bcra.gob.ar", [
		                RelativePath = "estadisticas/v4.0/Monetarias/" & Number.ToText(ID),
		                Query = [Desde = Date.ToText(FechaDesde, "yyyy-MM-dd"), Hasta = Date.ToText(FechaHasta, "yyyy-MM-dd"),
		                         Limit = Text.From(Limite), Offset = Text.From(Desplazamiento)],
		                Timeout = #duration(0,0,2,0)
		            ])),
		            Resultado = if Record.FieldOrDefault(Respuesta, "status", 200) <> 200 then
		                error Error.Record("BCRA", "La API devolvió un error; se conserva la última carga válida.", [idVariable=ID])
		                else Respuesta[results],
		            Detalle = List.Combine(List.Transform(Resultado, each _[detalle])),
		            Filas = List.Transform(Detalle, each [idVariable=ID, fecha=Date.From(_[fecha]), valor=Number.From(_[valor])])
		        in Filas,
		    Serie = (ID as number) as list =>
		        let
		            Paginas = List.Generate(
		                () => [Offset=0, Filas=Pagina(ID,0)],
		                each not List.IsEmpty([Filas]),
		                each let Siguiente=[Offset]+List.Count([Filas]) in
		                    [Offset=Siguiente, Filas=if List.Count([Filas]) < Limite then {} else Pagina(ID,Siguiente)],
		                each [Filas]),
		            Filas = List.Combine(Paginas)
		        in if List.IsEmpty(Filas) then error Error.Record("BCRA", "La serie solicitada no devolvió observaciones.", [idVariable=ID]) else Filas,
		    Datos = Table.FromRecords(List.Combine(List.Transform(Validados, each Serie(_))),
		                type table [idVariable=Int64.Type, fecha=date, valor=number]),
		    Unicos = Table.Distinct(Datos, {"idVariable","fecha"}),
		    Resultado = if Table.RowCount(Unicos) <> Table.RowCount(Datos) then error "La API devolvió fechas duplicadas; revisar paginación."
		                else Table.Sort(Unicos, {{"idVariable",Order.Ascending},{"fecha",Order.Ascending}})
		in Resultado
	lineageTag: e56824a0-9b3c-422a-a0e4-9806128f45a8
	queryGroup: Aux

