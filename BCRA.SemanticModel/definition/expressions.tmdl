expression ConsultarChequesRechazados =
		// ============================================================
		// FUNCIÓN 3: ConsultarChequesRechazados
		// Devuelve los cheques rechazados con sus causales
		// ============================================================
		//
		// RETORNA tabla con columnas:
		//   identificacion, denominacion, causal, entidad, nroCheque, fechaRechazo,
		//   monto, fechaPago, fechaPagoMulta, estadoMulta, ctaPersonal, denomJuridica,
		//   enRevision, procesoJud
		//
		// USO: ConsultarChequesRechazados("20123456789")
		//
		// NOTA: copiar este bloque como una consulta separada en Power Query
		//
		let
		    ConsultarChequesRechazados =
		        let
		            func = (identificacion as text) as table =>
		                let
		                    // ==================== PASO 1: VALIDACIÓN DEL CUIT ====================
		                    CUITLimpio = Text.Trim(identificacion),
		
		                    _validar =
		                        if Text.Length(CUITLimpio) = 0 then
		                            error Error.Record("Parámetro Inválido", "La identificación no puede estar vacía", identificacion)
		                        else if Text.Length(CUITLimpio) <> 11 then
		                            error Error.Record("Parámetro Inválido", "El CUIT/CUIL/CDI debe tener exactamente 11 dígitos", [Ingresado = identificacion, Longitud = Text.Length(CUITLimpio)])
		                        else
		                            true,
		
		                    // ==================== PASO 2: LLAMADA A LA API ====================
		                    // URL en minúsculas — la API es case-sensitive
		                    UrlCompleta = "https://api.bcra.gob.ar/centraldedeudores/v1.0/Deudas/ChequesRechazados/" & CUITLimpio,
		
		                    RespuestaHttp =
		                        if _validar then
		                            Web.Contents(
		                                UrlCompleta,
		                                [
		                                    Headers = [#"User-Agent" = "PowerQuery-BCRA-Client"],
		                                    ManualStatusHandling = {400, 404, 500}
		                                ]
		                            )
		                        else
		                            null,
		
		                    // ==================== PASO 3: LEER STATUS HTTP ====================
		                    StatusCode = Value.Metadata(RespuestaHttp)[Response.Status],
		
		                    // ==================== PASO 4: TABLA VACÍA TIPADA (reutilizable) ====================
		                    TablaVacia = #table(
		                        type table [
		                            identificacion = text, denominacion = text, causal = text,
		                            entidad = Int64.Type, nroCheque = Int64.Type, fechaRechazo = date,
		                            monto = number, fechaPago = date, fechaPagoMulta = date,
		                            estadoMulta = text, ctaPersonal = logical, denomJuridica = text,
		                            enRevision = logical, procesoJud = logical
		                        ],
		                        {}
		                    ),
		
		                    // ==================== PASO 5: MANEJO POR STATUS ====================
		                    Resultado =
		                        if StatusCode = 404 then
		                            // Sin datos = resultado válido, devuelve tabla vacía
		                            TablaVacia
		                        else if StatusCode = 400 then
		                            error Error.Record("Error 400 - Parámetro Inválido", "El CUIT/CUIL/CDI ingresado tiene un formato incorrecto.", [CUIT = CUITLimpio])
		                        else if StatusCode = 500 then
		                            error Error.Record("Error 500 - Error del Servidor", "La API del BCRA devolvió un error interno. Reintente más tarde.", [CUIT = CUITLimpio])
		                        else
		                            // ==================== PASO 6: PARSEO JSON (status 200) ====================
		                            let
		                                DatosJson = try Json.Document(RespuestaHttp) otherwise
		                                    error Error.Record("Error de Parseo", "La respuesta no pudo interpretarse como JSON.", [URL = UrlCompleta, Status = StatusCode]),
		
		                                _validarResults =
		                                    if not Record.HasFields(DatosJson, "results") then
		                                        error Error.Record("Sin Resultados", "La respuesta no contiene el campo 'results'.", [Status = DatosJson[status], CUIT = CUITLimpio])
		                                    else
		                                        true,
		
		                                Results        = if _validarResults then DatosJson[results] else null,
		                                Identificacion = Text.From(Results[identificacion]),
		                                Denominacion   = Results[denominacion],
		                                Causales       = Results[causales],
		
		                                // ==================== PASO 7: EXPANSIÓN CAUSAL → ENTIDAD → DETALLE ====================
		                                TablaCausales = Table.FromList(
		                                    Causales, Splitter.SplitByNothing(), {"causalRec"}, null, ExtraValues.Error
		                                ),
		
		                                TablaConCausal = Table.AddColumn(
		                                    TablaCausales, "causal", each Record.Field([causalRec], "causal")
		                                ),
		
		                                TablaConEntidades = Table.AddColumn(
		                                    TablaConCausal, "entidades", each Record.Field([causalRec], "entidades")
		                                ),
		
		                                TablaExpandidaEntidades = Table.ExpandListColumn(
		                                    Table.RemoveColumns(TablaConEntidades, {"causalRec"}), "entidades"
		                                ),
		
		                                TablaConEntidadId = Table.AddColumn(
		                                    TablaExpandidaEntidades, "entidad", each Record.Field([entidades], "entidad")
		                                ),
		
		                                TablaConDetalle = Table.AddColumn(
		                                    TablaConEntidadId, "detalle", each Record.Field([entidades], "detalle")
		                                ),
		
		                                TablaExpandidaDetalle = Table.ExpandListColumn(
		                                    Table.RemoveColumns(TablaConDetalle, {"entidades"}), "detalle"
		                                ),
		
		                                TablaExpandidaRec = Table.ExpandRecordColumn(
		                                    TablaExpandidaDetalle,
		                                    "detalle",
		                                    {"nroCheque", "fechaRechazo", "monto", "fechaPago", "fechaPagoMulta",
		                                     "estadoMulta", "ctaPersonal", "denomJuridica", "enRevision", "procesoJud"},
		                                    {"nroCheque", "fechaRechazo", "monto", "fechaPago", "fechaPagoMulta",
		                                     "estadoMulta", "ctaPersonal", "denomJuridica", "enRevision", "procesoJud"}
		                                ),
		
		                                TablaConId    = Table.AddColumn(TablaExpandidaRec, "identificacion", each Identificacion),
		                                TablaConDenom = Table.AddColumn(TablaConId,        "denominacion",   each Denominacion),
		
		                                TablaReordenada = Table.ReorderColumns(
		                                    TablaConDenom,
		                                    {"identificacion", "denominacion", "causal", "entidad", "nroCheque",
		                                     "fechaRechazo", "monto", "fechaPago", "fechaPagoMulta", "estadoMulta",
		                                     "ctaPersonal", "denomJuridica", "enRevision", "procesoJud"}
		                                ),
		
		                                TablaFinal = Table.TransformColumnTypes(
		                                    TablaReordenada,
		                                    {
		                                        {"identificacion", type text},    {"denominacion",   type text},
		                                        {"causal",         type text},    {"entidad",        Int64.Type},
		                                        {"nroCheque",      Int64.Type},   {"fechaRechazo",   type date},
		                                        {"monto",          type number},  {"fechaPago",       type date},
		                                        {"fechaPagoMulta", type date},    {"estadoMulta",    type text},
		                                        {"ctaPersonal",    type logical}, {"denomJuridica",  type text},
		                                        {"enRevision",     type logical}, {"procesoJud",     type logical}
		                                    }
		                                )
		                            in
		                                TablaFinal
		                in
		                    Resultado
		        in
		            func,
		
		    TipoFuncion = type function (
		        identificacion as (type text meta [
		            Documentation.FieldCaption = "CUIT / CUIL / CDI",
		            Documentation.FieldDescription = "Identificación fiscal de 11 dígitos (sin guiones)",
		            Documentation.SampleValues = {"30644586983", "20321251871"}
		        ])
		    ) as table meta [
		        Documentation.Name = "ConsultarChequesRechazados",
		        Documentation.LongDescription = "
		Consulta los cheques rechazados de una persona humana o jurídica en la Central de Cheques Rechazados del BCRA (API v1.0).
		
		Si el CUIT no registra cheques rechazados (HTTP 404), devuelve una tabla vacía sin error.
		
		CAUSALES: Sin fondos | Defectos formales
		ESTADO MULTA: IMPAGA | SUSPENDIDO | SUSPENDIDA
		Los montos se expresan en pesos. No requiere autenticación.",
		        Documentation.Examples = {[
		            Description = "CUIT con cheques rechazados",
		            Code = "ConsultarChequesRechazados(""30717283186"")",
		            Result = "Tabla con cheques, causales, montos y estados de multa."
		        ],[
		            Description = "CUIT sin cheques rechazados",
		            Code = "ConsultarChequesRechazados(""30644586983"")",
		            Result = "Tabla vacía (sin filas) — el CUIT no registra cheques rechazados."
		        ]}
		    ]
		in
		    Value.ReplaceType(ConsultarChequesRechazados, TipoFuncion)
	lineageTag: 5562c016-d288-4529-9b62-e6ea523ead2e
	queryGroup: Aux

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Function

