expression ConsultarCentralDeudores =
		// ============================================================================================
		// FUNCIONES PARA LA API CENTRAL DE DEUDORES - BCRA v1.0
		// ============================================================================================
		// BASE URL: https://api.bcra.gob.ar/CentralDeDeudores/v1.0/
		//
		// ENDPOINTS DISPONIBLES:
		//   1. ConsultarDeudas(CUIT)             → Situación actual del último período informado
		//   2. ConsultarDeudasHistoricas(CUIT)   → Historial crediticio de los últimos 24 meses
		//   3. ConsultarChequesRechazados(CUIT)  → Cheques rechazados con sus causales
		//
		// PARÁMETRO COMÚN: identificacion (CUIT/CUIL/CDI de 11 dígitos, como texto)
		//
		// NOTAS:
		//   - No requiere autenticación
		//   - Los montos están expresados en MILES de pesos
		//   - Situación 1=Normal | 2=Seguimiento especial | 3=Con problemas
		//               4=Alto riesgo insolvencia | 5=Irrecuperable
		// ============================================================================================
		
		
		// ============================================================
		// FUNCIÓN 1: ConsultarDeudas
		// Devuelve la situación crediticia del último período informado
		// ============================================================
		//
		// RETORNA tabla con columnas:
		//   identificacion, denominacion, periodo, entidad, situacion,
		//   fechaSit1, monto, diasAtrasoPago, refinanciaciones,
		//   recategorizacionOblig, situacionJuridica, irrecDisposicionTecnica,
		//   enRevision, procesoJud
		//
		// USO: ConsultarDeudas("20123456789")
		//
		let
		    ConsultarDeudas =
		        let
		            func = (identificacion as text) as table =>
		                let
		                    // ==================== PASO 1: VALIDACIÓN ====================
		                    CUITLimpio = Text.Trim(identificacion),
		
		                    ValidarCUIT =
		                        if Text.Length(CUITLimpio) = 0 then
		                            error Error.Record("Parámetro Inválido", "La identificación no puede estar vacía", identificacion)
		                        else if Text.Length(CUITLimpio) <> 11 then
		                            error Error.Record("Parámetro Inválido", "El CUIT/CUIL/CDI debe tener exactamente 11 dígitos", [Ingresado = identificacion, Longitud = Text.Length(CUITLimpio)])
		                        else
		                            true,
		
		                    // ==================== PASO 2: LLAMADA A LA API ====================
		                    UrlCompleta = "https://api.bcra.gob.ar/CentralDeDeudores/v1.0/Deudas/" & CUITLimpio,
		
		                    RespuestaHttp = try Web.Contents(
		                        UrlCompleta,
		                        [Headers = [#"User-Agent" = "PowerQuery-BCRA-Client"]]
		                    ) otherwise null,
		
		                    DatosJson = if RespuestaHttp <> null then
		                        try Json.Document(RespuestaHttp) otherwise null
		                    else
		                        null,
		
		                    // ==================== PASO 3: VALIDACIÓN DE RESPUESTA ====================
		                    ValidarRespuesta =
		                        if DatosJson = null then
		                            error Error.Record("Error de Conectividad", "No se pudo obtener respuesta de la API del BCRA", UrlCompleta)
		                        else if Record.HasFields(DatosJson, "errorMessages") then
		                            error Error.Record("Error de API", Text.Combine(List.Transform(DatosJson[errorMessages], each _), " | "), [Status = DatosJson[status], CUIT = CUITLimpio])
		                        else
		                            true,
		
		                    // ==================== PASO 4: EXTRACCIÓN DE DATOS ====================
		                    Results      = DatosJson[results],
		                    Identificacion = Text.From(Results[identificacion]),
		                    Denominacion   = Results[denominacion],
		                    Periodos       = Results[periodos],
		
		                    // ==================== PASO 5: EXPANSIÓN PERIODO → ENTIDAD ====================
		                    TablaPeriodos = Table.FromList(Periodos, Splitter.SplitByNothing(), {"periodoRec"}, null, ExtraValues.Error),
		
		                    TablaConPeriodo = Table.AddColumn(TablaPeriodos, "periodo", each Record.Field([periodoRec], "periodo")),
		                    TablaConEntidades = Table.AddColumn(TablaConPeriodo, "entidades", each Record.Field([periodoRec], "entidades")),
		
		                    TablaExpandidaEntidades = Table.ExpandListColumn(
		                        Table.RemoveColumns(TablaConEntidades, {"periodoRec"}),
		                        "entidades"
		                    ),
		
		                    TablaExpandidaRec = Table.ExpandRecordColumn(
		                        TablaExpandidaEntidades,
		                        "entidades",
		                        {"entidad", "situacion", "fechaSit1", "monto", "diasAtrasoPago",
		                         "refinanciaciones", "recategorizacionOblig", "situacionJuridica",
		                         "irrecDisposicionTecnica", "enRevision", "procesoJud"},
		                        {"entidad", "situacion", "fechaSit1", "monto", "diasAtrasoPago",
		                         "refinanciaciones", "recategorizacionOblig", "situacionJuridica",
		                         "irrecDisposicionTecnica", "enRevision", "procesoJud"}
		                    ),
		
		                    // ==================== PASO 6: AGREGAR COLUMNAS DE IDENTIFICACIÓN ====================
		                    TablaConId = Table.AddColumn(TablaExpandidaRec, "identificacion", each Identificacion),
		                    TablaConDenom = Table.AddColumn(TablaConId, "denominacion", each Denominacion),
		
		                    // ==================== PASO 7: REORDENAR Y TIPAR ====================
		                    TablaReordenada = Table.ReorderColumns(
		                        TablaConDenom,
		                        {"identificacion", "denominacion", "periodo", "entidad", "situacion",
		                         "fechaSit1", "monto", "diasAtrasoPago", "refinanciaciones",
		                         "recategorizacionOblig", "situacionJuridica", "irrecDisposicionTecnica",
		                         "enRevision", "procesoJud"}
		                    ),
		
		                    TablaFinal = Table.TransformColumnTypes(
		                        TablaReordenada,
		                        {
		                            {"identificacion",          type text},
		                            {"denominacion",            type text},
		                            {"periodo",                 type text},
		                            {"entidad",                 type text},
		                            {"situacion",               Int64.Type},
		                            {"fechaSit1",               type date},
		                            {"monto",                   type number},
		                            {"diasAtrasoPago",          Int64.Type},
		                            {"refinanciaciones",        type logical},
		                            {"recategorizacionOblig",   type logical},
		                            {"situacionJuridica",       type logical},
		                            {"irrecDisposicionTecnica", type logical},
		                            {"enRevision",              type logical},
		                            {"procesoJud",              type logical}
		                        }
		                    )
		                in
		                    TablaFinal
		        in
		            func,
		
		    TipoFuncion = type function (
		        identificacion as text
		    ) as table meta [
		        Documentation.Name = "ConsultarDeudas",
		        Documentation.LongDescription = "
		Consulta la situación crediticia actual de una persona humana o jurídica en la Central de Deudores del BCRA.
		Devuelve el último período informado por cada entidad financiera.
		
		SITUACIONES:
		  1 = Normal
		  2 = Seguimiento especial / Riesgo bajo
		  3 = Con problemas / Riesgo medio
		  4 = Alto riesgo de insolvencia / Riesgo alto
		  5 = Irrecuperable
		
		Los montos se expresan en MILES de pesos.",
		        Documentation.Examples = {
		            [
		                Description = "Consultar deudas actuales de una empresa",
		                Code = "ConsultarDeudas(""30500010912"")",
		                Result = "Tabla con la situación crediticia del último período informado por cada entidad."
		            ]
		        },
		        Documentation.Author = "Adaptado de ConsultarDatosBCRA - API Central de Deudores v1.0"
		    ]
		in
		    Value.ReplaceType(ConsultarDeudas, TipoFuncion)
	lineageTag: 1922b72d-858b-44f6-b3f8-5203ce65ca1d
	queryGroup: Aux

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Function

expression ConsultarDeudasHistoricas =
		// ============================================================
		// FUNCIÓN 2: ConsultarDeudasHistoricas
		// Devuelve la situación crediticia de los últimos 24 meses
		// ============================================================
		//
		// RETORNA tabla con columnas:
		//   identificacion, denominacion, periodo, entidad, situacion, monto, enRevision, procesoJud
		//
		// USO: ConsultarDeudasHistoricas("20123456789")
		//
		// NOTA: copiar este bloque como una consulta separada en Power Query
		//
		let
		    ConsultarDeudasHistoricas =
		        let
		            func = (identificacion as text) as table =>
		                let
		                    // ==================== PASO 1: VALIDACIÓN DEL CUIT ====================
		                    CUITLimpio = Text.Trim(identificacion),
		
		                    _validar =
		                        if Text.Length(CUITLimpio) = 0 then
		                            error Error.Record("Parámetro Inválido", "La identificación no puede estar vacía", identificacion)
		                        else if Text.Length(CUITLimpio) <> 11 then
		                            error Error.Record("Parámetro Inválido", "El CUIT/CUIL/CDI debe tener exactamente 11 dígitos", [Ingresado = identificacion, Longitud = Text.Length(CUITLimpio)])
		                        else
		                            true,
		
		                    // ==================== PASO 2: LLAMADA A LA API ====================
		                    UrlCompleta = "https://api.bcra.gob.ar/CentralDeDeudores/v1.0/Deudas/Historicas/" & CUITLimpio,
		
		                    RespuestaHttp = try Web.Contents(
		                        UrlCompleta,
		                        [Headers = [#"User-Agent" = "PowerQuery-BCRA-Client"]]
		                    ) otherwise null,
		
		                    // ==================== PASO 3: PARSEO Y VALIDACIÓN DE RESPUESTA ====================
		                    // Se parsea primero y luego se valida el contenido ANTES de acceder a [results]
		                    DatosJson =
		                        if _validar and RespuestaHttp <> null then
		                            try Json.Document(RespuestaHttp) otherwise null
		                        else if RespuestaHttp = null then
		                            error Error.Record("Error de Conectividad", "No se pudo establecer conexión con la API del BCRA. Verificar conectividad.", UrlCompleta)
		                        else
		                            null,
		
		                    // Validación del contenido JSON — esto se evalúa ANTES de acceder a [results]
		                    _validarJson =
		                        if DatosJson = null then
		                            error Error.Record("Error de Parseo", "La respuesta de la API no pudo ser interpretada como JSON.", UrlCompleta)
		                        else if not Record.HasFields(DatosJson, "status") then
		                            error Error.Record("Respuesta Inesperada", "La API no devolvió un campo 'status'. Estructura de respuesta desconocida.", UrlCompleta)
		                        else if DatosJson[status] = 400 then
		                            error Error.Record("Error 400 - Parámetro Inválido", Text.Combine(List.Transform(DatosJson[errorMessages], each Text.From(_)), " | "), [CUIT = CUITLimpio])
		                        else if DatosJson[status] = 404 then
		                            error Error.Record("Error 404 - No Encontrado", "No se encontraron datos para el CUIT/CUIL/CDI ingresado.", [CUIT = CUITLimpio])
		                        else if DatosJson[status] = 500 then
		                            error Error.Record("Error 500 - Error del Servidor", "La API del BCRA devolvió un error interno.", [CUIT = CUITLimpio])
		                        else if not Record.HasFields(DatosJson, "results") then
		                            error Error.Record("Sin Resultados", "La respuesta no contiene el campo 'results'.", [Status = DatosJson[status], CUIT = CUITLimpio])
		                        else
		                            true,
		
		                    // ==================== PASO 4: EXTRACCIÓN — solo se ejecuta si _validarJson = true ====================
		                    Results        = if _validarJson then DatosJson[results] else null,
		                    Identificacion = Text.From(Results[identificacion]),
		                    Denominacion   = Results[denominacion],
		                    Periodos       = Results[periodos],
		
		                    // ==================== PASO 5: EXPANSIÓN PERIODO → ENTIDAD ====================
		                    TablaPeriodos = Table.FromList(
		                        Periodos, Splitter.SplitByNothing(), {"periodoRec"}, null, ExtraValues.Error
		                    ),
		
		                    TablaConPeriodo = Table.AddColumn(
		                        TablaPeriodos, "periodo", each Record.Field([periodoRec], "periodo")
		                    ),
		
		                    TablaConEntidades = Table.AddColumn(
		                        TablaConPeriodo, "entidades", each Record.Field([periodoRec], "entidades")
		                    ),
		
		                    TablaExpandidaEntidades = Table.ExpandListColumn(
		                        Table.RemoveColumns(TablaConEntidades, {"periodoRec"}),
		                        "entidades"
		                    ),
		
		                    TablaExpandidaRec = Table.ExpandRecordColumn(
		                        TablaExpandidaEntidades,
		                        "entidades",
		                        {"entidad", "situacion", "monto", "enRevision", "procesoJud"},
		                        {"entidad", "situacion", "monto", "enRevision", "procesoJud"}
		                    ),
		
		                    // ==================== PASO 6: AGREGAR IDENTIFICACION Y DENOMINACION ====================
		                    TablaConId    = Table.AddColumn(TablaExpandidaRec, "identificacion", each Identificacion),
		                    TablaConDenom = Table.AddColumn(TablaConId,        "denominacion",   each Denominacion),
		
		                    // ==================== PASO 7: REORDENAR Y APLICAR TIPOS ====================
		                    TablaReordenada = Table.ReorderColumns(
		                        TablaConDenom,
		                        {"identificacion", "denominacion", "periodo", "entidad",
		                         "situacion", "monto", "enRevision", "procesoJud"}
		                    ),
		
		                    TablaFinal = Table.TransformColumnTypes(
		                        TablaReordenada,
		                        {
		                            {"identificacion", type text},
		                            {"denominacion",   type text},
		                            {"periodo",        type text},
		                            {"entidad",        type text},
		                            {"situacion",      Int64.Type},
		                            {"monto",          type number},
		                            {"enRevision",     type logical},
		                            {"procesoJud",     type logical}
		                        }
		                    )
		                in
		                    TablaFinal
		        in
		            func,
		
		    TipoFuncion = type function (
		        identificacion as (type text meta [
		            Documentation.FieldCaption = "CUIT / CUIL / CDI",
		            Documentation.FieldDescription = "Identificación fiscal de 11 dígitos (sin guiones)",
		            Documentation.SampleValues = {"20321251871", "30500010912"}
		        ])
		    ) as table meta [
		        Documentation.Name = "ConsultarDeudasHistoricas",
		        Documentation.LongDescription = "
		Consulta el historial crediticio de los últimos 24 meses de una persona humana o jurídica
		en la Central de Deudores del BCRA (API v1.0).
		
		SITUACIONES:
		  1 = Normal
		  2 = Seguimiento especial / Riesgo bajo
		  3 = Con problemas / Riesgo medio
		  4 = Alto riesgo de insolvencia / Riesgo alto
		  5 = Irrecuperable
		
		Los montos se expresan en MILES de pesos.
		No requiere autenticación.",
		        Documentation.Examples = {
		            [
		                Description = "Historial de los últimos 24 meses de una persona jurídica",
		                Code = "ConsultarDeudasHistoricas(""30500010912"")",
		                Result = "Tabla con situación crediticia mensual por entidad."
		            ]
		        }
		    ]
		in
		    Value.ReplaceType(ConsultarDeudasHistoricas, TipoFuncion)
