	/// Proporción decimal; mostrar como porcentaje. Último dato de la serie hasta el corte seleccionado.
	measure 'Tasa BADLAR Bancos Privados' = CALCULATE([Ultimo Valor], REMOVEFILTERS(BCRA_Principales_Variables), BCRA_Datos[idVariable] = 7) / 100
		formatString: 0.0%;-0.0%;0.0%
