	/// Diferencia entre tasas de referencia; no equivale al margen contable de un banco.
	measure 'Spread Tasas Active-Pasivas' = ([Tasa Adelantos en Cta Cte] - [Tasa BADLAR Bancos Privados]) * 100
		formatString: 0.00" pp";-0.00" pp";0.00" pp"
		displayFolder: 03 · Tasas y credito
		lineageTag: 95e6e258-1902-4bd4-a912-15b03c708f31

	measure 'Spread Interbancario' = ([Tasa Préstamos entre Bancos] - [Tasa BADLAR Bancos Privados]) * 100
		formatString: 0.00" pp";-0.00" pp";0.00" pp"
		displayFolder: 03 · Tasas y credito
		lineageTag: bb9080ca-9031-4833-977a-6e080790e22b

	/// Estimación mensual ex post. BADLAR al cierre previo; sin previsión de tasas ni inflación.
	measure 'Tasa Real BADLAR' =
			VAR Fecha=MAX('Analisis Mensual'[fecha])
			VAR Tasa=CALCULATE([Tasa BADLAR Bancos Privados],REMOVEFILTERS(Calendario),Calendario[Fechas]=EOMONTH(Fecha,-1))
			VAR IPC=[IPC Mensual Observado]
			RETURN IF(NOT ISBLANK(Tasa) && NOT ISBLANK(IPC),DIVIDE(1+Tasa*DAY(Fecha)/365,1+IPC)-1)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 · Ahorro
		lineageTag: 5cec274b-4f38-4694-a7e7-b535004c7974

	/// Proporción decimal; mostrar como porcentaje. Último dato de la serie hasta el corte seleccionado.
	measure 'Inflacion Mensual' = CALCULATE([Ultimo Valor], REMOVEFILTERS(BCRA_Principales_Variables), BCRA_Datos[idVariable] = 27) / 100
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 · Panorama
		lineageTag: b8463f12-187f-424e-9b4e-1e7989023783

	measure 'Inflacion Trimestral' =
			VAR Fecha=MAX('Analisis Mensual'[fecha])
			VAR Ventana=FILTER(ALL('Analisis Mensual'),'Analisis Mensual'[fecha]>EOMONTH(Fecha,-3) && 'Analisis Mensual'[fecha]<=Fecha)
			RETURN IF(COUNTROWS(Ventana)=3 && COUNTX(Ventana,'Analisis Mensual'[inflacionMensual])=3,
			    PRODUCTX(Ventana,1+'Analisis Mensual'[inflacionMensual])-1)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 · Series mensuales
		lineageTag: fc159b80-dfcb-4740-99f1-06859396acc5

