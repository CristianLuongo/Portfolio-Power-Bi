	measure 'Dias desde Maximo' =
			VAR Corte=[Fecha de corte]
			VAR Historia=CALCULATETABLE(BCRA_Datos,REMOVEFILTERS(Calendario),BCRA_Datos[fecha]<=Corte)
			VAR Extremo=MAXX(Historia,BCRA_Datos[valor])
			VAR Fecha=MAXX(FILTER(Historia,BCRA_Datos[valor]=Extremo),BCRA_Datos[fecha])
			RETURN IF(HASONEVALUE(BCRA_Datos[idVariable]) && NOT ISBLANK(Fecha),DATEDIFF(Fecha,Corte,DAY))
		formatString: 0
		isHidden
		displayFolder: 99 · Auxiliares
		lineageTag: 21d63e7a-3810-49f2-961f-bb5e38566854

	measure 'Dias desde Minimo' =
			VAR Corte=[Fecha de corte]
			VAR Historia=CALCULATETABLE(BCRA_Datos,REMOVEFILTERS(Calendario),BCRA_Datos[fecha]<=Corte)
			VAR Extremo=MINX(Historia,BCRA_Datos[valor])
			VAR Fecha=MAXX(FILTER(Historia,BCRA_Datos[valor]=Extremo),BCRA_Datos[fecha])
			RETURN IF(HASONEVALUE(BCRA_Datos[idVariable]) && NOT ISBLANK(Fecha),DATEDIFF(Fecha,Corte,DAY))
		formatString: 0
		isHidden
		displayFolder: 99 · Auxiliares
		lineageTag: d35a4981-c6a7-492a-bca5-b745c380cae9

