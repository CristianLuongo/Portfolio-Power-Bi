	/// Última observación de una única serie hasta la fecha de corte; no implica fecha de publicación.
	measure 'Fecha ultimo dato' =
			VAR Corte = [Fecha de corte]
			RETURN IF(CALCULATE(HASONEVALUE(BCRA_Datos[idVariable]),REMOVEFILTERS(Calendario)),
			    CALCULATE(MAX(BCRA_Datos[fecha]), REMOVEFILTERS(Calendario), BCRA_Datos[fecha] <= Corte))
		formatString: dd/MM/yyyy
		displayFolder: 01 · Panorama
		lineageTag: 4b3a1928-784c-4980-aa82-9e12e19ba31f

	/// Último dato disponible. Devuelve vacío cuando se mezclan variables de distintas unidades.
	measure 'Ultimo Valor' =
			VAR Fecha = [Fecha ultimo dato]
			RETURN IF(NOT ISBLANK(Fecha), CALCULATE(MAX(BCRA_Datos[valor]), REMOVEFILTERS(Calendario), BCRA_Datos[fecha] = Fecha))
		formatString: #,0.00
		displayFolder: 01 · Panorama
		lineageTag: 265dd662-0d2d-409c-8a6b-164e6e98f539

	measure 'Fecha Tasa BADLAR Bancos Privados' = CALCULATE([Fecha ultimo dato], REMOVEFILTERS(BCRA_Principales_Variables), BCRA_Datos[idVariable] = 7)
