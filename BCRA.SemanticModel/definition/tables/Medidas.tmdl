	measure 'Variacion % Mensual' =
			VAR Actual=[Ultimo Valor]
			VAR Fecha=[Fecha ultimo dato]
			VAR Previa=EOMONTH(Fecha,-1)
			VAR Anterior=CALCULATE([Ultimo Valor],REMOVEFILTERS(Calendario),Calendario[Fechas]=Previa)
			RETURN IF(NOT ISBLANK(Actual) && NOT ISBLANK(Anterior),DIVIDE(Actual,Anterior)-1)
		formatString: 0.0%;-0.0%;0.0%
		isHidden
		displayFolder: 99 · Auxiliares
		lineageTag: d467d56f-d3c8-4db8-ad26-3e315b10e43a

	measure 'Variacion % Anual' =
			VAR Actual=[Ultimo Valor]
			VAR Fecha=[Fecha ultimo dato]
			VAR Previa=EOMONTH(Fecha,-12)
			VAR Anterior=CALCULATE([Ultimo Valor],REMOVEFILTERS(Calendario),Calendario[Fechas]=Previa)
			RETURN IF(NOT ISBLANK(Actual) && NOT ISBLANK(Anterior),DIVIDE(Actual,Anterior)-1)
		formatString: 0.0%;-0.0%;0.0%
		isHidden
		displayFolder: 99 · Auxiliares
		lineageTag: ffd69317-4b08-4117-8fa6-0d6da3a4db0b

	measure 'Acumulado Anual' =
			VAR Actual=[Ultimo Valor]
			VAR Fecha=[Fecha ultimo dato]
			VAR Anterior=CALCULATE([Ultimo Valor],REMOVEFILTERS(Calendario),Calendario[Fechas]=DATE(YEAR(Fecha)-1,12,31))
			RETURN IF(NOT ISBLANK(Actual) && NOT ISBLANK(Anterior),DIVIDE(Actual,Anterior)-1)
		formatString: 0.0%;-0.0%;0.0%
		isHidden
		displayFolder: 99 · Auxiliares
		lineageTag: c1d8a555-2bae-4b57-9bfa-0c429b0d84da

	measure 'Promedio 30 Dias' =
			VAR Fecha=[Fecha ultimo dato]
			RETURN IF(NOT ISBLANK(Fecha),CALCULATE([Promedio Valores],REMOVEFILTERS(Calendario),
			    DATESBETWEEN(Calendario[Fechas],Fecha-29,Fecha)))
		formatString: #,0.00
		isHidden
		displayFolder: 99 · Auxiliares
		lineageTag: ceb52de5-fcea-4de6-b40e-9a2efba53fd0

	measure 'Promedio 90 Dias' =
