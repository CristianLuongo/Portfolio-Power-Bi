	measure 'IPC Nivel Reconstruido' =
			VAR Fecha = MAX('Analisis Mensual'[fecha])
			RETURN CALCULATE(MAX('Analisis Mensual'[indicePrecios]), 'Analisis Mensual'[fecha] = Fecha)
		formatString: #,0.00
