	measure 'Periodo Simulado' =
			VAR Inicio=[Fecha Inicio Simulacion]
			VAR Fin=[Fecha Fin Simulacion]
			RETURN IF(ISBLANK(Fin) || Fin<Inicio,"Seleccioná un inicio anterior al último mes disponible",
			    "Del " & FORMAT(Inicio,"dd/MM/yyyy") & " al " & FORMAT(Fin,"dd/MM/yyyy"))
		displayFolder: 04 · Ahorro
		lineageTag: 4acca65b-1416-4db1-b92c-6470637e12ce

	measure 'Primera Observacion' = CALCULATE(MIN(BCRA_Datos[fecha]),REMOVEFILTERS(Calendario))
		formatString: dd/MM/yyyy
		displayFolder: 05 · Calidad
		lineageTag: 43b9919e-d46c-4ef1-a929-990e1fb32f1e

	measure 'Ultima Observacion' = CALCULATE(MAX(BCRA_Datos[fecha]),REMOVEFILTERS(Calendario))
		formatString: dd/MM/yyyy
		displayFolder: 05 · Calidad
		lineageTag: 650336a2-c130-4275-b85b-0f42ef7ca291

	measure Observaciones = CALCULATE(COUNTROWS(BCRA_Datos),REMOVEFILTERS(Calendario))
		formatString: #,0
		displayFolder: 05 · Calidad
		lineageTag: 87aaead6-2b76-4d46-b08c-5a695561984f

	measure 'Dias Desde Observacion' = VAR Fecha=[Ultima Observacion] RETURN IF(NOT ISBLANK(Fecha),DATEDIFF(Fecha,TODAY(),DAY))
		formatString: 0
		displayFolder: 05 · Calidad
		lineageTag: f15ad062-dc91-46e9-bfc0-569777394ce5

	measure 'Series Cargadas' = CALCULATE(DISTINCTCOUNT(BCRA_Datos[idVariable]),REMOVEFILTERS(Calendario))
		formatString: 0
		displayFolder: 05 · Calidad
		lineageTag: 2e811603-c51f-49be-bfcf-69ac3692d9da

	measure Duplicados = COUNTROWS(BCRA_Datos)-COUNTROWS(SUMMARIZE(BCRA_Datos,BCRA_Datos[idVariable],BCRA_Datos[fecha]))
		formatString: 0
		displayFolder: 05 · Calidad
		lineageTag: 90d57bf0-5f64-4bb7-b029-95822e65449b

	measure 'Meses Sin IPC' = COUNTROWS(FILTER(ALL('Analisis Mensual'),ISBLANK('Analisis Mensual'[inflacionMensual])))
		formatString: 0
		displayFolder: 05 · Calidad
		lineageTag: e428d9a8-9acc-4b9e-80ca-34eb64ca4799

	measure 'Actualizacion Argentina' = MAX('Control Actualizacion'[ActualizadoUTC])-TIME(3,0,0)
		formatString: dd/MM/yyyy HH:mm
		displayFolder: 05 · Calidad
		lineageTag: 6a8d15ff-9a98-409e-852d-f7c87b0d4c5d

	measure 'Estado Datos' =
			VAR Faltan=10-[Series Cargadas]
			RETURN SWITCH(TRUE(),Faltan>0,"Faltan "&FORMAT(Faltan,"0")&" series",[Duplicados]>0,"Revisar duplicados",
			    [Meses Sin IPC]>0,"Hay meses sin IPC: comparaciones incompletas","10 series · sin duplicados ni meses faltantes de IPC")
		displayFolder: 05 · Calidad
		lineageTag: 920e8fca-c281-4f8b-a59d-9f2c06d1e9af

	partition Medidas = m
		mode: import
		queryGroup: Aux
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

