	/// Proporción decimal; mostrar como porcentaje. Último dato de la serie hasta el corte seleccionado.
	measure 'Tasa Préstamos entre Bancos' = CALCULATE([Ultimo Valor], REMOVEFILTERS(BCRA_Principales_Variables), BCRA_Datos[idVariable] = 11) / 100
