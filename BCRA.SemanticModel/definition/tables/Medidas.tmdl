	measure 'Rentabilidad Real Depositos' =
			VAR Fecha=[Fecha mensual comparable]
			RETURN IF(NOT ISBLANK(Fecha),CALCULATE([Rentabilidad Real Mensual],REMOVEFILTERS(Calendario),'Analisis Mensual'[fecha]=Fecha))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 · Ahorro
		lineageTag: 634f38d1-937e-495b-bbed-0a963a4ad423

	/// Referencia mensual ex post; no es costo financiero total: excluye cargos, impuestos y comisiones.
	measure 'Costo Real Credito' =
			VAR Fecha=MAX('Analisis Mensual'[fecha])
			VAR Tasa=CALCULATE([Tasa Adelantos en Cta Cte],REMOVEFILTERS(Calendario),Calendario[Fechas]=EOMONTH(Fecha,-1))
			VAR IPC=[IPC Mensual Observado]
			RETURN IF(NOT ISBLANK(Tasa) && NOT ISBLANK(IPC),DIVIDE(1+Tasa*DAY(Fecha)/365,1+IPC)-1)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 · Tasas y credito
		lineageTag: bc54000e-80ac-4e42-abbc-4f0934bfc92a

	/// Diferencia entre estimaciones mensuales, no margen del sistema financiero.
	measure 'Margen Financiero Real' = [Costo Real Credito] - [Rentabilidad Real Mensual]
		formatString: 0.0%;-0.0%;0.0%
		isHidden
		displayFolder: 99 · Compatibilidad
