	/// Agregación de una sola variable. Sumar saldos, tasas o índices no representa una evolución temporal.
	measure 'Suma Valores' = IF(HASONEVALUE(BCRA_Datos[idVariable]), SUM(BCRA_Datos[valor]))
		formatString: #,0.00
		isHidden
		displayFolder: 99 · Auxiliares
		lineageTag: d1fbeb70-b6f7-4f37-9a45-4d950e177541

	/// Agregación de una sola variable. Sumar saldos, tasas o índices no representa una evolución temporal.
