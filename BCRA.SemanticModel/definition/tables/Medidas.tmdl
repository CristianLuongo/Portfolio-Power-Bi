	measure 'Fecha mensual comparable' =
			VAR Corte = [Fecha de corte]
			RETURN CALCULATE(MAX('Analisis Mensual'[fecha]), REMOVEFILTERS(Calendario),
			    'Analisis Mensual'[fecha] <= Corte, NOT ISBLANK('Analisis Mensual'[inflacionMensual]),
			    NOT ISBLANK('Analisis Mensual'[factorDepositos]), NOT ISBLANK('Analisis Mensual'[credito]))
		formatString: dd/MM/yyyy
		isHidden
		displayFolder: 01 · Panorama
		lineageTag: 790461c3-b114-438b-9f5a-a9d8f80982d7

	measure 'Spread Mensual Adelantos Depositos' = IF(NOT ISBLANK([Adelantos Promedio Mensual]) && NOT ISBLANK([Depositos Promedio Mensual]),([Adelantos Promedio Mensual] - [Depositos Promedio Mensual]) * 100)
		formatString: 0.00" pp";-0.00" pp";0.00" pp"
		displayFolder: 03 · Tasas y credito
		lineageTag: a3e66f90-8845-4727-b854-5664dfcdbfb3

	/// Ajuste interanual por IPC. El saldo incluye moneda local y extranjera expresada en pesos, con efecto de valuación cambiaria.
	measure 'Credito Real YoY' =
			VAR Nominal=[Credito Acumulado YoY]
			VAR Inflacion=[IPC Interanual Observado]
			RETURN IF(NOT ISBLANK(Nominal) && NOT ISBLANK(Inflacion), DIVIDE(1+Nominal,1+Inflacion)-1)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 · Tasas y credito
		lineageTag: aabeffb2-f7c6-4d32-bf5d-11943e541e6d

	measure 'Credito Real YoY Ultimo' =
			VAR Fecha=[Fecha mensual comparable]
			RETURN IF(NOT ISBLANK(Fecha), CALCULATE([Credito Real YoY],REMOVEFILTERS(Calendario),'Analisis Mensual'[fecha]=Fecha))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 · Panorama
		lineageTag: 8ef245e5-1cd1-4b4f-a892-faa7fce5d4c5

	/// Rendimiento ex post aproximado: TNA de depósitos al cierre del mes previo × días del mes / 365, deflactado por IPC del mes.
	measure 'Rentabilidad Real Mensual' =
			VAR Fecha=MAX('Analisis Mensual'[fecha])
			VAR Factor=CALCULATE(MAX('Analisis Mensual'[factorDepositos]),'Analisis Mensual'[fecha]=Fecha)
			VAR Inflacion=[IPC Mensual Observado]
			RETURN IF(NOT ISBLANK(Factor) && NOT ISBLANK(Inflacion), DIVIDE(Factor,1+Inflacion)-1)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 · Ahorro
		lineageTag: 901400f2-1c44-41e7-90cc-a5532a24d5a8

	measure 'Inflacion Acumulada Año' =
			VAR Fecha=MAX('Analisis Mensual'[fecha])
			VAR Ventana=FILTER(ALL('Analisis Mensual'),YEAR('Analisis Mensual'[fecha])=YEAR(Fecha) && 'Analisis Mensual'[fecha]<=Fecha)
			RETURN IF(COUNTROWS(Ventana)=MONTH(Fecha) && COUNTX(Ventana,'Analisis Mensual'[inflacionMensual])=MONTH(Fecha),
			    PRODUCTX(Ventana,1+'Analisis Mensual'[inflacionMensual])-1)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 · Series mensuales
		lineageTag: ca4f0bd2-041a-421e-b604-9988d9e612c4

	measure 'Capital Inicial' = SELECTEDVALUE('Monto Inicial'[Monto],1000000)
		formatString: "$ "#,0
		displayFolder: 04 · Ahorro
		lineageTag: a596323e-3591-42be-8b00-37be0aac0dbd

	measure 'Fecha Inicio Simulacion' =
			VAR CorteSeleccionado=MIN(MAXX(ALLSELECTED(Calendario),Calendario[Fechas]),TODAY())
			VAR Ultima=CALCULATE(MAX('Analisis Mensual'[fecha]),REMOVEFILTERS(Calendario),'Analisis Mensual'[fecha]<=CorteSeleccionado,NOT ISBLANK('Analisis Mensual'[indicePrecios]))
			VAR Primera=CALCULATE(MIN('Analisis Mensual'[fecha]),REMOVEFILTERS(Calendario),NOT ISBLANK('Analisis Mensual'[indicePrecios]))
			VAR Predeterminada=MAX(Primera,EOMONTH(Ultima,-12))
			RETURN IF(NOT ISBLANK(Ultima),SELECTEDVALUE('Inicio Simulacion'[Fecha],Predeterminada))
		formatString: dd/MM/yyyy
		displayFolder: 04 · Ahorro
		lineageTag: d6c279ca-a899-4b78-9623-60ebca72ac7e

	measure 'Fecha Fin Simulacion' =
			VAR Corte=[Fecha de corte]
			VAR Fin=CALCULATE(MAX('Analisis Mensual'[fecha]),REMOVEFILTERS(Calendario),'Analisis Mensual'[fecha]<=Corte,
			    NOT ISBLANK('Analisis Mensual'[indicePrecios]),NOT ISBLANK('Analisis Mensual'[dolar]))
			RETURN IF(ISINSCOPE(Calendario[Inicio del mes]) && EOMONTH(MAX(Calendario[Fechas]),0)<>Fin,BLANK(),Fin)
		formatString: dd/MM/yyyy
		displayFolder: 04 · Ahorro
		lineageTag: 84418516-2a74-4bf0-b59d-7768d93b90be

	measure 'Factor Depositos Simulado' =
			VAR Inicio=[Fecha Inicio Simulacion]
			VAR Fin=[Fecha Fin Simulacion]
			VAR Ventana=FILTER(ALL('Analisis Mensual'),'Analisis Mensual'[fecha]>Inicio && 'Analisis Mensual'[fecha]<=Fin)
			VAR Meses=DATEDIFF(Inicio,Fin,MONTH)
			RETURN IF(NOT ISBLANK(Inicio) && NOT ISBLANK(Fin) && Fin>=Inicio && COUNTROWS(Ventana)=Meses && COUNTX(Ventana,'Analisis Mensual'[factorDepositos])=Meses,
			    IF(Meses=0,1,PRODUCTX(Ventana,'Analisis Mensual'[factorDepositos])))
		formatString: #,0.00
		isHidden
		displayFolder: 04 · Ahorro
		lineageTag: 74608683-9ff5-4240-848a-dd4a3779f6b3

	measure 'Factor IPC Simulado' =
			VAR Inicio=[Fecha Inicio Simulacion]
			VAR Fin=[Fecha Fin Simulacion]
			VAR Inicial=CALCULATE(MAX('Analisis Mensual'[indicePrecios]),REMOVEFILTERS(Calendario),'Analisis Mensual'[fecha]=Inicio)
			VAR Final=CALCULATE(MAX('Analisis Mensual'[indicePrecios]),REMOVEFILTERS(Calendario),'Analisis Mensual'[fecha]=Fin)
			RETURN IF(NOT ISBLANK(Inicio) && NOT ISBLANK(Fin) && Fin>=Inicio && NOT ISBLANK(Inicial) && NOT ISBLANK(Final),DIVIDE(Final,Inicial))
		formatString: #,0.00
		isHidden
		displayFolder: 04 · Ahorro
		lineageTag: 5e2694fe-5973-44c7-88cf-5be71f28e2fc

	measure 'Factor Dolar Simulado' =
			VAR Inicio=[Fecha Inicio Simulacion]
			VAR Fin=[Fecha Fin Simulacion]
			VAR Inicial=CALCULATE(MAX('Analisis Mensual'[dolar]),REMOVEFILTERS(Calendario),'Analisis Mensual'[fecha]=Inicio)
			VAR Final=CALCULATE(MAX('Analisis Mensual'[dolar]),REMOVEFILTERS(Calendario),'Analisis Mensual'[fecha]=Fin)
			RETURN IF(NOT ISBLANK(Inicio) && NOT ISBLANK(Fin) && Fin>=Inicio && NOT ISBLANK(Inicial) && NOT ISBLANK(Final),DIVIDE(Final,Inicial))
		formatString: #,0.00
		isHidden
		displayFolder: 04 · Ahorro
		lineageTag: 5333f96e-bd86-4a03-a828-069831a14955

	measure 'Factor UVA Simulado' =
			VAR Inicio=[Fecha Inicio Simulacion]
			VAR Fin=[Fecha Fin Simulacion]
			VAR Inicial=CALCULATE(MAX('Analisis Mensual'[uva]),REMOVEFILTERS(Calendario),'Analisis Mensual'[fecha]=Inicio)
			VAR Final=CALCULATE(MAX('Analisis Mensual'[uva]),REMOVEFILTERS(Calendario),'Analisis Mensual'[fecha]=Fin)
			RETURN IF(NOT ISBLANK(Inicio) && NOT ISBLANK(Fin) && Fin>=Inicio && NOT ISBLANK(Inicial) && NOT ISBLANK(Final),DIVIDE(Final,Inicial))
		formatString: #,0.00
		isHidden
		displayFolder: 04 · Ahorro
		lineageTag: fb9c950c-7318-4891-aa61-f14d882e9719

	measure 'Factor CER Simulado' =
			VAR Inicio=[Fecha Inicio Simulacion]
			VAR Fin=[Fecha Fin Simulacion]
			VAR Inicial=CALCULATE(MAX('Analisis Mensual'[cer]),REMOVEFILTERS(Calendario),'Analisis Mensual'[fecha]=Inicio)
			VAR Final=CALCULATE(MAX('Analisis Mensual'[cer]),REMOVEFILTERS(Calendario),'Analisis Mensual'[fecha]=Fin)
			RETURN IF(NOT ISBLANK(Inicio) && NOT ISBLANK(Fin) && Fin>=Inicio && NOT ISBLANK(Inicial) && NOT ISBLANK(Final),DIVIDE(Final,Inicial))
		formatString: #,0.00
		isHidden
		displayFolder: 04 · Ahorro
		lineageTag: 6c96512e-4db0-4704-9f75-4623e8b1aaeb

	measure 'Capital Plazo Nominal' = [Capital Inicial]*[Factor Depositos Simulado]
		formatString: "$ "#,0
